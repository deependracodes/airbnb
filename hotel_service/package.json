{
  "name": "hotel_service",
  "version": "1.0.0",
  "description": "",
  "main": "server.js",
  "scripts": {
    "dev": "nodemon --watch src --exec tsx src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:migrate": "tsx ./node_modules/sequelize-cli/lib/sequelize db:migrate",
    "db:migrate:undo": "tsx ./node_modules/sequelize-cli/lib/sequelize db:migrate:undo",
    "db:seed": "tsx ./node_modules/sequelize-cli/lib/sequelize db:seed:all",
    "db:seed:undo": "tsx ./node_modules/sequelize-cli/lib/sequelize db:seed:undo"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "mysql2": "^3.24.5",
    "sequelize": "^6.37.8",
    "uuid": "^14.0.2",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "nodemon": "^3.1.14",
    "sequelize-cli": "^6.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
